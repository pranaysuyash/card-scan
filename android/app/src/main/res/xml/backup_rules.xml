<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android Auto Backup
    Specifies what data should be backed up to Google Drive
-->
<full-backup-content>
    <!-- Include user data -->
    <include domain="database" path="."/>
    <include domain="sharedpref" path="."/>
    <include domain="file" path="."/>

    <!-- Exclude sensitive data -->
    <exclude domain="sharedpref" path="FlutterSecureStorage"/>
    <exclude domain="database" path="WebView.db"/>
    <exclude domain="database" path="WebViewCache.db"/>

    <!-- Exclude temporary files -->
    <exclude domain="file" path="cache"/>
    <exclude domain="file" path="code_cache"/>
</full-backup-content>
