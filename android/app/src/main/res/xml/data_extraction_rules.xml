<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+)
    Specifies what data can be extracted during device-to-device transfer
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include user data for cloud backup -->
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="."/>

        <!-- Exclude sensitive data from cloud backup -->
        <exclude domain="sharedpref" path="FlutterSecureStorage"/>
    </cloud-backup>

    <device-transfer>
        <!-- Include data for device-to-device transfer -->
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="."/>

        <!-- Exclude sensitive data from device transfer -->
        <exclude domain="sharedpref" path="FlutterSecureStorage"/>
    </device-transfer>
</data-extraction-rules>
